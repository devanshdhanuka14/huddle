# .env.example
# Copy to .env (git-ignored) and change values there. Never commit .env.

# Postgres (dev container from deploy/compose.yaml)
DATABASE_URL=postgres://huddle:huddle@localhost:5433/huddle?sslmode=disable

# Redis (dev container)
REDIS_URL=redis://localhost:6380/0

# Go server
HTTP_ADDR=:8080
LOG_LEVEL=debug